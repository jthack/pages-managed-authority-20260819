#!/bin/sh
token_state=absent
runtime_token_state=absent
docker_state=absent
[ -n "${INPUT_TOKEN:-}" ] && token_state=present
[ -n "${ACTIONS_RUNTIME_TOKEN:-}" ] && runtime_token_state=present
[ -S /var/run/docker.sock ] && docker_state=present
marker='MANAGED_PAGES_SYMLINK_EXEC_20260819'
printf '%s identity="%s" input_token=%s runtime_token=%s docker_socket=%s\n' "$marker" "$(/usr/bin/id)" "$token_state" "$runtime_token_state" "$docker_state"
printf '%s\n' "$marker" > /github/workspace/managed-symlink-exec.txt
exit 0
