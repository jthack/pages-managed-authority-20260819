#!/bin/sh
token_state=absent
runtime_token_state=absent
docker_state=absent
[ -n "${INPUT_TOKEN:-}" ] && token_state=present
[ -n "${ACTIONS_RUNTIME_TOKEN:-}" ] && runtime_token_state=present
[ -S /var/run/docker.sock ] && docker_state=present

marker='MANAGED_PAGES_MARSHAL_EXEC_20260819'
printf '%s identity="%s" input_token=%s runtime_token=%s docker_socket=%s\n' \
  "$marker" "$(id)" "$token_state" "$runtime_token_state" "$docker_state" \
  > /github/workspace/MANAGED_PAGES_MARSHAL_EXEC_20260819.txt
printf '%s\n' "$marker"
printf 'controlled-revision\n'
